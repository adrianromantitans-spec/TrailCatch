{
  "expo": {
    "name": "TrailCatch",
    "slug": "trailcatch",
    "scheme": "trailcatch",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tunombre.trailcatch",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tunombre.trailcatch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#183C31"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrailCatch usa tu ubicación para marcar salidas y buscar senderos y lugares de pesca cerca de ti."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrailCatch usa las fotos que eliges para tu perfil y tu diario.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "TrailCatch usa la cámara para tu foto de perfil y para añadir fotos a tus salidas y capturas.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-web-browser"
    ]
  }
}
